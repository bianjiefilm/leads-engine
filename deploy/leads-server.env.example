# leads-engine server env sample (HUI-1748 L0)
# 目标路径(生产惯例):/etc/leads-engine/leads-server.env (0640, 不进 git)
# 值纪律:样例只有键名与说明,永不写入真实 token。

# ---- app ----
# 服务监听(loopback,不对公网)
LEADS_HTTP_ADDR=127.0.0.1:18230
# sqlite 数据文件路径
LEADS_DB_PATH=/var/lib/leads-engine/leads.db
# development | production
LEADS_ENV=production
# 平台 app_id(JWT aud;需平台侧 AUTH_APPS 登记)
LEADS_APP_ID=leads-engine
# web BFF -> 本服务共享内部令牌(随机生成,不与平台服务令牌复用)
LEADS_INTERNAL_TOKEN=
# 携带 identity 会话令牌的 Cookie 名
LEADS_SESSION_COOKIE=leads_session

# ---- platform identity(必配;缺任一键 = 鉴权动作全部 fail-closed)----
PLATFORM_IDENTITY_BASE_URL=http://127.0.0.1:18101
# 本 app 专用 identity 令牌(平台侧 IDENTITY_APP_TOKENS 登记;禁止万能 token)
PLATFORM_IDENTITY_TOKEN=
# canonical host(BFF 会话转发时的 Host 约定)
PLATFORM_IDENTITY_APP_HOST=leads.example.com

# ---- platform notify(出站脚手架;开关默认 off)----
FEATURE_NOTIFY=off
PLATFORM_NOTIFY_BASE_URL=http://127.0.0.1:18105
PLATFORM_NOTIFY_TOKEN=

# ---- Notify 接收入口(HUI-1680;默认 off = 路由不注册)----
# 只接受逗号分隔的已登记来源。密钥和取数地址由部署注入,事件里的 URL 一律不用。
# 每个来源三键:LEADS_INGEST_<APP>_SECRET / _FETCH_BASE / _FETCH_TOKEN
# <APP> 是 app id 大写并把 - 换成 _。未登记渠道保持关闭。
FEATURE_NOTIFY_INGEST=off
LEADS_INGEST_SOURCES=touch-engine
LEADS_INGEST_TOUCH_ENGINE_SECRET=
LEADS_INGEST_TOUCH_ENGINE_FETCH_BASE=
LEADS_INGEST_TOUCH_ENGINE_FETCH_TOKEN=
# 手机号指纹 pepper。接收入口打开时必填,与出站盐分开。
LEADS_DEDUP_PEPPER=

# 显式来源租户映射(HUI-2316)。空表示没有绑定。
# 旧式: external=target 或 external=target@version
# 显式: source_app/source_ns/external=target@version
# 一条重复或非法会丢弃整份列表,不会只留下先写的那条。
# 改这一行不会搬迁已落库的线索;已接收事件仍停在当时记下的目标。
# LEADS_TENANT_BINDINGS=touch-engine/notify/touchTenant=leadsTenant@1

# ---- 统一接待(HUI-1688;默认 off = 路由不注册)----
# 打开后必须单独配置访客钥匙 pepper,不复用 LEADS_DEDUP_PEPPER。
# live_charge 保持 0。下面三键都填了才会提交平台任务;缺任一键就文本降级,不记 Billing PASS。
FEATURE_RECEPTION=off
RECEPTION_VISITOR_PEPPER=
# PLATFORM_TASK_BASE_URL=
# PLATFORM_TASK_TOKEN=
# PLATFORM_TASK_ACCOUNT_ID=

# ---- platform upload(本票仅脚手架;开关默认 off)----
FEATURE_UPLOAD=off
PLATFORM_UPLOAD_BASE_URL=http://127.0.0.1:18104
PLATFORM_UPLOAD_TOKEN=

# ---- AI 外呼安全门(HUI-1687;默认 off = 路由不注册)----
# 打开也只做隔离演练。本进程没有真实线路，生产自动外呼保持关闭，不扣费。
FEATURE_OUTBOUND_CALL=off

# ---- 全漏斗分析(HUI-1694 / FEAT-0195;只读,开关默认 off = 路由不注册)----
FEATURE_FUNNEL=off
